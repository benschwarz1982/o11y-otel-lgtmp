# instrumentation/middleware/java/otel-java-agent.env.template
#
# Standard environment variables for any JVM-based application using
# the OpenTelemetry Java auto-instrumentation agent
# (https://github.com/open-telemetry/opentelemetry-java-instrumentation,
# -javaagent:/path/to/opentelemetry-javaagent.jar on the JVM's command
# line - see README.md in this directory for how to attach it).
#
# Application-owner-filled placeholders (the only things that change
# per application - everything else in this file is standard):
#   <SERVICE_NAME>       - this application's own name, e.g. "kundenverwaltung"
#   <SERVICE_NAMESPACE>  - a grouping label, e.g. the team or app family
#   <GATEWAY_ENDPOINT>   - where the agent sends OTLP (F03 - the tenant
#                          is bound server-side, never by a header):
#                          VM-based apps: http://127.0.0.1:4317, a local
#                          relay collector that forwards over mTLS with
#                          the application's own tenant certificate (see
#                          instrumentation/middleware/tomcat/collector-config.yaml).
#                          Kubernetes-based apps:
#                          http://otel-gateway-collector.observability.svc.cluster.local:4318
#                          - the gateway derives the tenant from the
#                          pod's namespace (manifest k8s_namespaces).
#   <TENANT_ID>           - this application's own onboarded tenant,
#                          e.g. "4711-prod" - never a middleware/platform
#                          tenant, see this repo's README "Middleware/
#                          runtime tenants" note: Java/Tomcat/.NET
#                          telemetry always belongs to the application
#                          that runs it. Selects the relay's client
#                          certificate / the namespace mapping; the
#                          header below is informational only and
#                          ignored by the gateway
#   <DEPLOYMENT_ENVIRONMENT> - this system's env from its manifest
#                          entry, e.g. "prod" (schema/core-v1.yaml)
#   <APP_OWNER>           - this system's manifest owner.team, e.g.
#                          "Web App Team" (schema/core-v1.yaml)
#   <APP_COST_CENTER>     - this system's manifest cost_center, e.g.
#                          "CC-4711" (schema/core-v1.yaml)
#   <APP_SIZE_CLASS>      - this system's manifest environments[].size
#                          for this environment, e.g. "M"
#                          (schema/core-v1.yaml)
#
# If the middleware itself also produces its own log FILES (not
# something the Java agent can pick up via OTLP on its own - e.g.
# Tomcat's catalina.out), that needs a small dedicated file-shipping
# collector alongside this - see instrumentation/middleware/tomcat/ for the
# concrete example.

OTEL_SERVICE_NAME=<SERVICE_NAME>
OTEL_RESOURCE_ATTRIBUTES=service.namespace=<SERVICE_NAMESPACE>,deployment.environment=<DEPLOYMENT_ENVIRONMENT>,app.owner=<APP_OWNER>,app.cost_center=<APP_COST_CENTER>,app.size_class=<APP_SIZE_CLASS>
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_INSTRUMENTATION_JAVA_UTIL_LOGGING_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=<GATEWAY_ENDPOINT>
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_HEADERS=tenant_id=<TENANT_ID>
