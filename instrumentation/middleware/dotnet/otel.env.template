# instrumentation/middleware/dotnet/otel.env.template
#
# Standard environment variables for a .NET application wired up with
# the OpenTelemetry .NET SDK directly (see README.md in this directory
# for why this repo uses direct SDK wiring in-app rather than the
# separate .NET auto-instrumentation bundle).
#
# Application-owner-filled placeholders:
#   <GATEWAY_ENDPOINT> - where the SDK sends OTLP (F03 - the tenant is
#                        bound server-side, never by a header). VM-based
#                        apps: http://127.0.0.1:4317, a local relay
#                        collector (service otelcol-app) that forwards
#                        over mTLS with the application's own tenant
#                        certificate (see collector-config.yaml here).
#   <TENANT_ID>         - this application's own onboarded tenant, e.g.
#                        "4722-prod" - never a middleware/platform
#                        tenant, see the platform repo README's
#                        "Middleware/runtime tenants" note. Selects the
#                        relay's client certificate; the header below
#                        is informational only and ignored by the
#                        gateway
#   <DEPLOYMENT_ENVIRONMENT> - this system's env from its manifest
#                        entry, e.g. "prod" (schema/core-v1.yaml)
#   <APP_OWNER>         - this system's manifest owner.team, e.g.
#                        "Platform Engineering" (schema/core-v1.yaml)
#   <APP_COST_CENTER>   - this system's manifest cost_center, e.g.
#                        "CC-4722" (schema/core-v1.yaml)
#   <APP_SIZE_CLASS>    - this system's manifest environments[].size
#                        for this environment, e.g. "S"
#                        (schema/core-v1.yaml)
#
# service.name is set in-app via the .NET SDK's own
# ResourceBuilder.CreateDefault().AddService(...) (see README.md in
# this directory), but CreateDefault() also includes the SDK's default
# env-var resource detector, which reads OTEL_RESOURCE_ATTRIBUTES the
# same way the Java agent does - so the schema attributes below reach
# the app through this file after all, no code change needed.

OTEL_RESOURCE_ATTRIBUTES=deployment.environment=<DEPLOYMENT_ENVIRONMENT>,app.owner=<APP_OWNER>,app.cost_center=<APP_COST_CENTER>,app.size_class=<APP_SIZE_CLASS>
OTEL_EXPORTER_OTLP_ENDPOINT=<GATEWAY_ENDPOINT>
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_HEADERS=tenant_id=<TENANT_ID>
