{
  "title": "Operator: Storage Showback",
  "uid": "operator-storage-showback",
  "description": "G06 (FR-09): object storage actually occupied per tenant and signal, measured hourly by the storage-usage CronJob (scripts/storage-usage.py) from the blob listing, against each tenant's showback storage budget (manifest size: S=5, M=50, L=125 GiB; scripts/provision.py SIZE_STORAGE_GB). Showback only - nothing is enforced on this value. The monthly cost is an estimate: stored GiB x the price variable (CHF per GiB-month, default roughly Azure Blob Hot LRS; data older than 7 days is in the cheaper Cool tier, G10).",
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(255, 96, 96, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "tags": [
    "operator",
    "multi-tenancy",
    "showback"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "tenant",
        "type": "query",
        "datasource": "Mimir-anonymous",
        "query": "label_values(demo_storage_bytes, tenant)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "price",
        "label": "CHF per GiB-month",
        "type": "textbox",
        "query": "0.02",
        "current": {
          "text": "0.02",
          "value": "0.02"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Stored volume, budget and estimated cost per tenant",
      "datasource": "Mimir-anonymous",
      "description": "One row per tenant. unattributed = blobs no single tenant owns (Pyroscope segments not yet compacted into per-tenant blocks, bucket metadata); anonymous = data written without a tenant (old, pre-F03 writes).",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 11
      },
      "targets": [
        {
          "refId": "metrics",
          "expr": "sum by (tenant) (last_over_time(demo_storage_bytes{tenant=~\"$tenant\",signal=\"metrics\"}[2h])) / 1024^3",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "format": "table"
        },
        {
          "refId": "logs",
          "expr": "sum by (tenant) (last_over_time(demo_storage_bytes{tenant=~\"$tenant\",signal=\"logs\"}[2h])) / 1024^3",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "format": "table"
        },
        {
          "refId": "traces",
          "expr": "sum by (tenant) (last_over_time(demo_storage_bytes{tenant=~\"$tenant\",signal=\"traces\"}[2h])) / 1024^3",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "format": "table"
        },
        {
          "refId": "profiles",
          "expr": "sum by (tenant) (last_over_time(demo_storage_bytes{tenant=~\"$tenant\",signal=\"profiles\"}[2h])) / 1024^3",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "format": "table"
        },
        {
          "refId": "total",
          "expr": "sum by (tenant) (last_over_time(demo_storage_bytes{tenant=~\"$tenant\"}[2h])) / 1024^3",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "format": "table"
        },
        {
          "refId": "budget",
          "expr": "sum by (tenant) (last_over_time(demo_storage_budget_bytes{tenant=~\"$tenant\"}[2h])) / 1024^3",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "format": "table"
        },
        {
          "refId": "used",
          "expr": "100 * sum by (tenant) (last_over_time(demo_storage_bytes{tenant=~\"$tenant\"}[2h])) / on(tenant) sum by (tenant) (last_over_time(demo_storage_budget_bytes{tenant=~\"$tenant\"}[2h]))",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "format": "table"
        },
        {
          "refId": "cost",
          "expr": "sum by (tenant) (last_over_time(demo_storage_bytes{tenant=~\"$tenant\"}[2h])) / 1024^3 * $price",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #metrics": "Metrics GiB",
              "Value #logs": "Logs GiB",
              "Value #traces": "Traces GiB",
              "Value #profiles": "Profiles GiB",
              "Value #total": "Total GiB",
              "Value #budget": "Budget GiB",
              "Value #used": "Budget used %",
              "Value #cost": "Est. CHF / month"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Budget used %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 80
                    },
                    {
                      "color": "red",
                      "value": 100
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Est. CHF / month"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyCHF"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Total GiB",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Storage budget used (%)",
      "datasource": "Mimir-anonymous",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (tenant) (last_over_time(demo_storage_bytes{tenant=~\"$tenant\"}[2h])) / on(tenant) sum by (tenant) (last_over_time(demo_storage_budget_bytes{tenant=~\"$tenant\"}[2h]))",
          "instant": true,
          "range": false,
          "legendFormat": "{{tenant}}",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Stored volume per tenant over time",
      "datasource": "Mimir-anonymous",
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tenant) (last_over_time(demo_storage_bytes{tenant=~\"$tenant\"}[2h]))",
          "instant": false,
          "range": true,
          "legendFormat": "{{tenant}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 20
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Stored volume per signal (selected tenants)",
      "datasource": "Mimir-anonymous",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (signal) (last_over_time(demo_storage_bytes{tenant=~\"$tenant\"}[2h]))",
          "instant": false,
          "range": true,
          "legendFormat": "{{signal}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 20
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
