# Terraform-managed replacement for scripts/fleet-4139-postgresql.sh /
# instrumentation-4139-postgresql.sh / destroy-fleet-4139-postgresql.sh
# AND scripts/fleet-4721-kundenverwaltung.sh /
# instrumentation-4721-kundenverwaltung.sh (no separate destroy script
# ever existed for 4721 - destroying this namespace already covered
# both) - IaC Roadmap milestone "Terraform for the Kubernetes-native
# demo apps".
#
# PostgreSQL here is Kundenverwaltung's (4721) own dedicated database -
# exclusively and permanently used by this one application, never
# shared - so it isn't a separate onboarded system/tenant either (see
# README.md's Multi-Tenancy "Middleware/runtime tenants" note); it used
# to be onboarded separately as system 4139, since folded into 4721 for
# that reason. This directory/Terraform state keeps the old
# "fleet-4139-postgresql" name deliberately: the GitLab-managed backend
# address encodes this state's name, so renaming it would mean
# migrating a live state (real risk of orphaning the currently-deployed
# resources) for a purely cosmetic gain - not worth it outside of a
# full teardown/rebuild, when there's no live state to lose. Only
# `deploy-fleets:4721-kundenverwaltung`/`deploy-instrumentations:4721-kundenverwaltung`/
# `destroy:4721-kundenverwaltung` apply this environment now (there
# used to be separate `*:4139-postgresql` CI jobs applying the exact
# same state - removed as redundant once 4139 stopped being tracked as
# its own system).

data "azurerm_kubernetes_cluster" "main" {
  name                = var.aks_cluster_name
  resource_group_name = var.resource_group_name
}

data "azurerm_dns_zone" "main" {
  name                = var.dns_zone_name
  resource_group_name = var.resource_group_name
}

resource "kubernetes_namespace_v1" "kundenverwaltung" {
  metadata {
    name = "kundenverwaltung"
  }
}

# ---------------------------------------------------------------------------
# PostgreSQL (Kundenverwaltung's own dedicated database)
# ---------------------------------------------------------------------------

# F09/NFR-03: generated, never in the repo. Alphanumeric only, so it can
# go into the ALTER USER statement below without any SQL escaping.
resource "random_password" "postgres" {
  length  = 32
  special = false
}

locals {
  # Pod template annotation on everything that reads the password from
  # the Secret below: env values are only read at container start, so a
  # new password must restart Postgres (postStart re-applies it), the
  # app and the metrics collector together.
  # nonsensitive(): a sensitive value in pod template annotations makes
  # the kubernetes provider (3.2.1) fail the apply with "Provider produced
  # inconsistent final plan ... inconsistent values for sensitive
  # attribute". A SHA-256 of a random 32-character password reveals
  # nothing usable.
  postgres_password_checksum = nonsensitive(sha256(random_password.postgres.result))

  # Same reasoning: restart the app when its Pyroscope password rotates.
  # Only with instrumentation - see data.kubernetes_secret_v1.pyroscope_ingest.
  pyroscope_ingest_annotations = var.instrument ? {
    "checksum/pyroscope-ingest" = nonsensitive(sha256(data.kubernetes_secret_v1.pyroscope_ingest[0].data["password"]))
  } : {}
}

# Pyroscope ingest credentials for tenant 4721-prod (F03), generated by
# terraform/environments/tenants and copied into this app's namespace -
# pods can't reference a Secret in another namespace. The ingest proxy
# derives the tenant from these, not from PYROSCOPE_TENANT_ID. Only read
# with instrumentation (deploy-instrumentations:4721), so the plain fleet
# deployment doesn't depend on the tenant rollout having run.
data "kubernetes_secret_v1" "pyroscope_ingest" {
  count = var.instrument ? 1 : 0
  metadata {
    name      = "pyroscope-ingest-4721-prod"
    namespace = "observability"
  }
}

resource "kubernetes_secret_v1" "pyroscope_ingest" {
  count = var.instrument ? 1 : 0
  metadata {
    name      = "pyroscope-ingest"
    namespace = kubernetes_namespace_v1.kundenverwaltung.metadata[0].name
  }

  data = {
    PYROSCOPE_BASIC_AUTH_USER     = data.kubernetes_secret_v1.pyroscope_ingest[0].data["username"]
    PYROSCOPE_BASIC_AUTH_PASSWORD = data.kubernetes_secret_v1.pyroscope_ingest[0].data["password"]
  }
}

resource "kubernetes_secret_v1" "postgres_credentials" {
  metadata {
    name      = "postgres-credentials"
    namespace = kubernetes_namespace_v1.kundenverwaltung.metadata[0].name
  }

  data = {
    POSTGRES_USER     = "kundenverwaltung"
    POSTGRES_PASSWORD = random_password.postgres.result
    POSTGRES_DB       = "kundenverwaltung"
  }
}

resource "kubernetes_service_v1" "postgres" {
  metadata {
    name      = "postgres"
    namespace = kubernetes_namespace_v1.kundenverwaltung.metadata[0].name
  }

  spec {
    selector   = { app = "postgres" }
    cluster_ip = "None"

    port {
      port        = 5432
      target_port = 5432
    }
  }
}

# Plain StatefulSet with the official image, no Helm chart/operator -
# single-instance demo database, not something needing HA/backups.
# kubernetes_stateful_set waits for the rollout (pod Ready, including
# the readiness_probe below) before Terraform considers this resource
# applied - replaces the old script's explicit `kubectl wait
# --for=condition=Ready`.
resource "kubernetes_stateful_set_v1" "postgres" {
  metadata {
    name      = "postgres"
    namespace = kubernetes_namespace_v1.kundenverwaltung.metadata[0].name
  }

  spec {
    service_name = kubernetes_service_v1.postgres.metadata[0].name
    replicas     = 1

    selector {
      match_labels = {
        app = "postgres"
      }
    }

    template {
      metadata {
        labels = {
          app = "postgres"
        }
        annotations = {
          "checksum/postgres-password" = local.postgres_password_checksum
        }
      }

      spec {
        # PostgreSQL 16 -> 19: 19 starts a fresh cluster in its own PVC
        # subPath (postgresql/19/docker, see the data mount below); the old
        # 16 cluster stays untouched in subPath pgdata as a fallback - this
        # demo database only holds synthetic customers that
        # app/4721-kundenverwaltung recreates. Delete pgdata by hand once
        # 19 is verified.
        container {
          name  = "postgres"
          image = "postgres:19"

          # UC4's DB slow-query logs (the onboarding repo's own demo
          # use case, previously a deliberate gap - see
          # postgres-otel-logs-collector's own comment below for the
          # sidecar that ships these). jsonlog, not the default
          # stderr/plain-text format - trivially parseable by the
          # sidecar's json_parser operator, no fragile regex needed.
          # 200ms threshold: slow enough to skip routine chatter, low
          # enough to actually show something in this small demo DB.
          args = [
            "-c", "logging_collector=on",
            "-c", "log_destination=jsonlog",
            "-c", "log_min_duration_statement=200",
            "-c", "log_directory=/var/log/postgresql",
            # Postgres's own default (0600, owner-only) - found live: the
            # sidecar runs as a different, non-root uid than the postgres
            # server process, so it got "permission denied" opening the
            # file. 0644 is still only readable within this one pod's
            # shared emptyDir, not exposed any wider.
            "-c", "log_file_mode=0644",
          ]

          port {
            container_port = 5432
          }

          # The official image applies POSTGRES_PASSWORD only when it
          # initialises an empty data directory - on the existing PVC a
          # new password in the Secret would never reach the database.
          # So every start re-applies it over the local socket (trust
          # auth in the image's pg_hba.conf), retrying until the server
          # accepts connections, each attempt bounded by timeouts.
          # The password never appears in a log or process list: the SQL
          # goes to psql via stdin (printf is a shell builtin, so no argv),
          # and statement/duration/error logging is switched off for this
          # session first - the slow-query jsonlog is shipped to Loki.
          # A rotation briefly fails logins of the old app pod until the
          # new one (checksum annotation) has started - acceptable for
          # this single-replica demo.
          lifecycle {
            post_start {
              exec {
                command = ["sh", "-c", <<-EOT
                  export PGCONNECT_TIMEOUT=5
                  for i in $(seq 1 60); do
                    printf '%s\n' \
                      "SET log_statement = 'none';" \
                      "SET log_min_duration_statement = -1;" \
                      "SET log_min_error_statement = PANIC;" \
                      "SET statement_timeout = '5s';" \
                      "ALTER USER \"$POSTGRES_USER\" PASSWORD '$POSTGRES_PASSWORD';" \
                      | timeout 10 psql -q -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$POSTGRES_DB" \
                      >/dev/null 2>&1 && exit 0
                    sleep 2
                  done
                  echo "postStart: could not apply POSTGRES_PASSWORD" >&2
                  exit 1
                EOT
                ]
              }
            }
          }

          env_from {
            secret_ref {
              name = kubernetes_secret_v1.postgres_credentials.metadata[0].name
            }
          }

          volume_mount {
            name = "data"
            # PostgreSQL 18+ images keep PGDATA in a major-version
            # subdirectory (/var/lib/postgresql/19/docker) and expect the
            # volume on /var/lib/postgresql, so future major upgrades can
            # run pg_upgrade --link side by side on the same volume.
            mount_path = "/var/lib/postgresql"
            sub_path   = "postgresql"
          }
          volume_mount {
            name       = "postgres-logs"
            mount_path = "/var/log/postgresql"
          }

          resources {
            requests = {
              cpu    = "100m"
              memory = "256Mi"
            }
            limits = {
              memory = "512Mi"
            }
          }

          readiness_probe {
            exec {
              command = ["pg_isready", "-U", "kundenverwaltung"]
            }
            initial_delay_seconds = 5
            period_seconds        = 5
          }
        }

        # Reads the jsonlog file postgres writes to the shared
        # postgres-logs volume above and ships it to the gateway as
        # tenant 4721-prod (Kundenverwaltung's own tenant - this
        # database is exclusively and permanently dedicated to that one
        # application) - sidecar in the same pod, not a node-wide
        # DaemonSet or a separate Deployment, since the log file only
        # ever exists on whichever node this one postgres pod happens
        # to land on. Same "dedicated collector, own tenant" convention
        # as postgres-otel-collector's own metrics (see this file's
        # kubernetes_manifest.postgres_otel_collector) and
        # instrumentation/middleware/tomcat/'s otelcol-tomcat for the VM-based
        # equivalent - see instrumentation/applications/4721-kundenverwaltung/postgres-otel-logs-config.yaml's
        # own header comment for the full reasoning.
        container {
          name  = "postgres-otel-logs"
          image = "otel/opentelemetry-collector-contrib:0.166.0"

          args = ["--config=/etc/otelcol-contrib/config.yaml"]

          resources {
            requests = {
              cpu    = "50m"
              memory = "128Mi"
            }
            limits = {
              memory = "256Mi"
            }
          }

          volume_mount {
            name       = "postgres-logs"
            mount_path = "/var/log/postgresql"
            read_only  = true
          }
          volume_mount {
            name       = "postgres-otel-logs-config"
            mount_path = "/etc/otelcol-contrib"
          }
        }

        volume {
          name = "postgres-logs"
          empty_dir {}
        }
        volume {
          name = "postgres-otel-logs-config"
          config_map {
            name = kubernetes_config_map_v1.postgres_otel_logs_config.metadata[0].name
          }
        }
      }
    }

    volume_claim_template {
      metadata {
        name = "data"
      }
      spec {
        access_modes = ["ReadWriteOnce"]
        resources {
          requests = {
            storage = "2Gi"
          }
        }
      }
    }
  }
}

resource "kubernetes_config_map_v1" "postgres_otel_logs_config" {
  metadata {
    name      = "postgres-otel-logs-config"
    namespace = kubernetes_namespace_v1.kundenverwaltung.metadata[0].name
  }

  data = {
    "config.yaml" = file("${path.module}/../../../instrumentation/applications/4721-kundenverwaltung/postgres-otel-logs-config.yaml")
  }
}

# ---------------------------------------------------------------------------
# Kundenverwaltung (system 4721) - the application itself
# ---------------------------------------------------------------------------

resource "kubernetes_config_map_v1" "kundenverwaltung_source" {
  metadata {
    name      = "kundenverwaltung-source"
    namespace = kubernetes_namespace_v1.kundenverwaltung.metadata[0].name
  }

  # app/4721-kundenverwaltung/Main.java stays a separate file (not
  # inlined) - the canonical reference, same reason as every other
  # *-demo source file this milestone keeps as file().
  data = {
    "Main.java" = file("${path.module}/../../../app/4721-kundenverwaltung/Main.java")
  }
}

resource "kubernetes_service_v1" "kundenverwaltung" {
  metadata {
    name      = "kundenverwaltung"
    namespace = kubernetes_namespace_v1.kundenverwaltung.metadata[0].name
  }

  spec {
    selector = { app = "kundenverwaltung" }

    port {
      port        = 8080
      target_port = 8080
    }
  }
}

resource "kubernetes_deployment_v1" "kundenverwaltung" {
  metadata {
    name      = "kundenverwaltung"
    namespace = kubernetes_namespace_v1.kundenverwaltung.metadata[0].name
  }

  spec {
    replicas = 1

    selector {
      match_labels = {
        app = "kundenverwaltung"
      }
    }

    template {
      metadata {
        labels = {
          app                           = "kundenverwaltung"
          "app.kubernetes.io/component" = "kundenverwaltung"
        }
        annotations = merge({
          "checksum/postgres-password" = local.postgres_password_checksum
        }, local.pyroscope_ingest_annotations)
      }

      spec {
        # No container build/registry - downloads the OTel Java agent +
        # JDBC driver jars and compiles Main.java at pod start, sharing
        # an emptyDir with the runtime container. Same "no custom image"
        # approach as ansible/roles/middleware-tomcat/ (downloads Tomcat
        # + the OTel Java agent onto the VM directly, no custom image
        # either).
        # Two steps: the eclipse-temurin 25 images no longer ship curl (or
        # wget), so a curl image fetches the jars and the JDK only compiles.
        init_container {
          name  = "download"
          image = "curlimages/curl:8.23.0"

          command = ["sh", "-c", <<-EOT
            set -eu
            curl -fsSL -o /shared/opentelemetry-javaagent.jar \
              https://github.com/open-telemetry/opentelemetry-java-instrumentation/releases/download/v2.34.0/opentelemetry-javaagent.jar
            curl -fsSL -o /shared/pyroscope-javaagent.jar \
              https://github.com/grafana/pyroscope-java/releases/download/v2.9.2/pyroscope.jar
            curl -fsSL -o /shared/opentelemetry-api.jar \
              https://repo1.maven.org/maven2/io/opentelemetry/opentelemetry-api/1.68.0/opentelemetry-api-1.68.0.jar
            curl -fsSL -o /shared/opentelemetry-context.jar \
              https://repo1.maven.org/maven2/io/opentelemetry/opentelemetry-context/1.68.0/opentelemetry-context-1.68.0.jar
            # opentelemetry-common: split out of the API since 1.6x
            # (io.opentelemetry.common.ComponentLoader), needed at compile
            # and run time.
            curl -fsSL -o /shared/opentelemetry-common.jar \
              https://repo1.maven.org/maven2/io/opentelemetry/opentelemetry-common/1.68.0/opentelemetry-common-1.68.0.jar
            curl -fsSL -o /shared/postgresql.jar \
              https://repo1.maven.org/maven2/org/postgresql/postgresql/42.7.15/postgresql-42.7.15.jar
          EOT
          ]

          volume_mount {
            name       = "shared"
            mount_path = "/shared"
          }
        }

        init_container {
          name  = "prepare"
          image = "eclipse-temurin:25-jdk"

          command = ["javac", "-cp", "/shared/opentelemetry-api.jar:/shared/opentelemetry-context.jar:/shared/opentelemetry-common.jar", "/config/Main.java", "-d", "/shared"]

          volume_mount {
            name       = "shared"
            mount_path = "/shared"
          }
          volume_mount {
            name       = "source"
            mount_path = "/config"
          }
        }

        container {
          name  = "kundenverwaltung"
          image = "eclipse-temurin:25-jre"

          # INSTRUMENT toggles whether the OTel Java agent is attached -
          # var.instrument, mirroring the original app.yaml's own
          # comment. The OTEL_* env vars below stay present either way
          # (harmless when the agent isn't attached) - Kundenverwaltung
          # pushes straight to the gateway with its own tenant from the
          # start, unlike 1294/4015's endpoint-toggling.
          command = ["sh", "-c", <<-EOT
            set -eu
            CP="/shared:/shared/opentelemetry-api.jar:/shared/opentelemetry-context.jar:/shared/opentelemetry-common.jar:/shared/postgresql.jar"
            if [ "$${INSTRUMENT:-false}" = "true" ]; then
              exec java -cp "$CP" -javaagent:/shared/opentelemetry-javaagent.jar -javaagent:/shared/pyroscope-javaagent.jar Main
            else
              exec java -cp "$CP" Main
            fi
          EOT
          ]

          port {
            container_port = 8080
          }

          env {
            name  = "INSTRUMENT"
            value = tostring(var.instrument)
          }
          env {
            name  = "DB_URL"
            value = "jdbc:postgresql://${kubernetes_service_v1.postgres.metadata[0].name}.${kubernetes_namespace_v1.kundenverwaltung.metadata[0].name}.svc.cluster.local:5432/kundenverwaltung"
          }
          env {
            name = "DB_USER"
            value_from {
              secret_key_ref {
                name = kubernetes_secret_v1.postgres_credentials.metadata[0].name
                key  = "POSTGRES_USER"
              }
            }
          }
          env {
            name = "DB_PASSWORD"
            value_from {
              secret_key_ref {
                name = kubernetes_secret_v1.postgres_credentials.metadata[0].name
                key  = "POSTGRES_PASSWORD"
              }
            }
          }
          env {
            name  = "OTEL_SERVICE_NAME"
            value = "kundenverwaltung"
          }
          env {
            # instrumentation/schema/core.yaml's Core Schema - platform.type is
            # static (Kubernetes-pod-based); the rest mirrors this
            # system's own manifest entry (owner.team/cost_center/
            # environments[].size).
            name  = "OTEL_RESOURCE_ATTRIBUTES"
            value = "service.namespace=kundenverwaltung,platform.type=kubernetes,deployment.environment=prod,app.owner=Platform Engineering,app.cost_center=CC-4721,app.size_class=M"
          }
          env {
            name  = "OTEL_TRACES_EXPORTER"
            value = "otlp"
          }
          env {
            name  = "OTEL_METRICS_EXPORTER"
            value = "otlp"
          }
          env {
            name  = "OTEL_LOGS_EXPORTER"
            value = "otlp"
          }
          env {
            name  = "OTEL_INSTRUMENTATION_JAVA_UTIL_LOGGING_ENABLED"
            value = "true"
          }
          env {
            name  = "OTEL_EXPORTER_OTLP_ENDPOINT"
            value = "http://otel-gateway-collector.observability.svc.cluster.local:4318"
          }
          env {
            name  = "OTEL_EXPORTER_OTLP_PROTOCOL"
            value = "http/protobuf"
          }
          # Ignored by the gateway since F03 - it derives the tenant
          # from this pod's namespace (manifest k8s_namespaces). Kept so
          # the app config still says which tenant it belongs to.
          # Traces, logs, and JVM runtime metrics all report as this
          # app's own tenant - no separate metrics header override
          # (used to split JVM metrics off to a separate "Java
          # Plattform" platform tenant, 3168, merged into 4721 since
          # that JVM runtime was only ever used by this one
          # application - see this repo's README "Middleware/runtime
          # tenants" note).
          env {
            name  = "OTEL_EXPORTER_OTLP_HEADERS"
            value = "tenant_id=4721-prod"
          }

          # Continuous profiling (Pyroscope) - see B12 in the main
          # README. Deliberately not through the gateway (OTLP
          # profiles is still experimental in the collector version
          # this repo pins) - pushes to the Pyroscope ingest proxy's
          # in-cluster Service, which authenticates the tenant (Basic
          # Auth from the Secret below) and sets X-Scope-OrgID itself.
          env {
            name  = "PYROSCOPE_APPLICATION_NAME"
            value = "kundenverwaltung"
          }
          env {
            name  = "PYROSCOPE_SERVER_ADDRESS"
            value = "http://pyroscope-ingest.observability.svc.cluster.local:4040"
          }
          dynamic "env_from" {
            for_each = kubernetes_secret_v1.pyroscope_ingest
            content {
              secret_ref {
                name = env_from.value.metadata[0].name
              }
            }
          }

          env_from {
            secret_ref {
              name = kubernetes_secret_v1.postgres_credentials.metadata[0].name
            }
          }

          resources {
            requests = {
              cpu    = "100m"
              memory = "256Mi"
            }
            limits = {
              memory = "512Mi"
            }
          }

          volume_mount {
            name       = "shared"
            mount_path = "/shared"
          }
        }

        volume {
          name = "shared"
          empty_dir {}
        }
        volume {
          name = "source"
          config_map {
            name = kubernetes_config_map_v1.kundenverwaltung_source.metadata[0].name
          }
        }
      }
    }
  }

  # No attribute reference ties this Deployment to the StatefulSet (the
  # DB_URL above is a hardcoded DNS name, not a Terraform reference) -
  # explicit depends_on for the same ordering the old script's `kubectl
  # wait --for=condition=Ready pod -l app=postgres` provided.
  depends_on = [kubernetes_stateful_set_v1.postgres]
}

# ---------------------------------------------------------------------------
# Public ingress (kundenverwaltung.<dns-zone>) - same
# time_sleep/data-source/azurerm_dns_a_record pattern
# terraform/environments/observability-stack already uses for Grafana,
# just per-app here (provisioning-scoped, not telemetry-scoped). Traefik
# already exists (deployed by deploy:observability-stack, which already
# ran and stabilized before this job runs) - no wait needed here, unlike
# that environment's own time_sleep (which waits for a Traefik it's
# creating in the same apply).
# ---------------------------------------------------------------------------

data "kubernetes_service_v1" "traefik" {
  metadata {
    name      = "traefik"
    namespace = "ingress-traefik"
  }
}

resource "azurerm_dns_a_record" "kundenverwaltung" {
  name                = "kundenverwaltung"
  zone_name           = data.azurerm_dns_zone.main.name
  resource_group_name = var.resource_group_name
  ttl                 = 300
  records             = [data.kubernetes_service_v1.traefik.status[0].load_balancer[0].ingress[0].ip]
}

# Certificate/IngressRoute are CRD instances with no typed provider
# resource - kubernetes_manifest + yamldecode(file(...)), same pattern
# already live-tested in terraform/environments/observability-stack-crs
# for Grafana's own cert/ingressroute. Well-typed schemas (unlike
# OpenTelemetryCollector below), low risk of the provider bug that hit
# otel-gateway-collector.yaml - see that module's own comment.
resource "kubernetes_manifest" "kundenverwaltung_cert" {
  manifest = yamldecode(templatefile("${path.module}/../../../k8s/ingress/kundenverwaltung-cert.yaml", { dns_zone_name = var.dns_zone_name }))
}

resource "kubernetes_manifest" "kundenverwaltung_ingressroute" {
  manifest   = yamldecode(templatefile("${path.module}/../../../k8s/ingress/kundenverwaltung-ingressroute.yaml", { dns_zone_name = var.dns_zone_name }))
  depends_on = [kubernetes_manifest.kundenverwaltung_cert]
}

# ---------------------------------------------------------------------------
# Postgres's own OTel collector (reports under 4721-prod, Kundenverwaltung's
# own tenant) - never existed before the instrumentation step, so
# count-gated rather than always-present-but-toggled like
# 1294/4015. OpenTelemetryCollector is the one CRD kind that reproduced
# the kubernetes_manifest provider bug elsewhere in this repo
# (otel-gateway-collector.yaml, see observability-stack-crs's own
# comment) - if this one hits the same "Provider produced inconsistent
# result after apply" error, fall back to the exact same null_resource +
# kubectl apply/kubectl delete pattern used there.
# ---------------------------------------------------------------------------

locals {
  postgres_otel_collector = yamldecode(file("${path.module}/../../../instrumentation/applications/4721-kundenverwaltung/postgres-otel-collector.yaml"))
}

resource "kubernetes_manifest" "postgres_otel_collector" {
  count = var.instrument ? 1 : 0

  # podAnnotations merged in here, not in the YAML: restarts the
  # collector when the password it reads from the Secret changes.
  manifest = merge(local.postgres_otel_collector, {
    spec = merge(local.postgres_otel_collector.spec, {
      podAnnotations = { "checksum/postgres-password" = local.postgres_password_checksum }
    })
  })
  depends_on = [kubernetes_stateful_set_v1.postgres]
}

# moved blocks for the kubernetes provider v3 rename -
# unversioned resource types deprecated in favour of _v1 (see
# the provider's own v3.0.0 CHANGELOG) - required so Terraform
# treats this as a rename of the same live object, not a
# destroy+recreate.
moved {
  from = kubernetes_namespace.kundenverwaltung
  to   = kubernetes_namespace_v1.kundenverwaltung
}

moved {
  from = kubernetes_secret.postgres_credentials
  to   = kubernetes_secret_v1.postgres_credentials
}

moved {
  from = kubernetes_service.postgres
  to   = kubernetes_service_v1.postgres
}

moved {
  from = kubernetes_stateful_set.postgres
  to   = kubernetes_stateful_set_v1.postgres
}

moved {
  from = kubernetes_config_map.postgres_otel_logs_config
  to   = kubernetes_config_map_v1.postgres_otel_logs_config
}

moved {
  from = kubernetes_config_map.kundenverwaltung_source
  to   = kubernetes_config_map_v1.kundenverwaltung_source
}

moved {
  from = kubernetes_service.kundenverwaltung
  to   = kubernetes_service_v1.kundenverwaltung
}

