# Terraform-managed replacement for scripts/deploy-tenants.sh's
# datasources/dashboards rollout - IaC Roadmap milestone "Terraform for
# deploy:tenants' datasources/dashboards". Almost everything here is
# onboarding-scoped (auto-generated by the onboarding repo's
# scripts/provision.py, committed straight to this repo, nothing
# hand-authored) and deliberately a separate Terraform state from
# observability-stack so `deploy:tenants` stays independently,
# incrementally runnable without touching the full platform stack - see
# backend.tf. The one exception is kubernetes_config_map_v1.alert_rules
# below: its 5 files are fixed, hand-authored content (not generated
# from manifests), but deploying them lives here anyway, alongside the
# same systems' dashboards/datasources - content generation and
# deployment location are different axes, see that resource's own
# comment for why moving just the latter here fixed a real live bug.
#
# Also owns the gateway OpenTelemetryCollector CR (kubernetes/
# collectors/otel-gateway-collector.yaml) - moved here from
# observability-stack-crs (IaC Roadmap milestone, done): that file
# embeds the onboarding tenant allowlist (`filter/reject_unknown_tenants`,
# auto-generated by the onboarding repo's scripts/provision.py from the
# same manifests as the datasources/dashboards above), so it needs to
# roll out on the same onboarding-approval cadence as everything else in
# this state, not on `deploy:observability-stack`'s platform-only
# cadence - otherwise a fresh platform deploy would already accept every
# fixed-fleet tenant's telemetry before any of them actually went
# through onboarding/approval. The network path (Services, Traefik) is
# platform-scoped, the actual collector Deployment (created by the OTel
# Operator from this CR) is onboarding-scoped.
#
# Explicitly NOT here: the Mimir/Loki ingestion-budget `helm upgrade
# --reuse-values` calls (see .gitlab-ci.yml's deploy:tenants job) -
# those layer onto helm_release.mimir/helm_release.loki, already owned
# by observability-stack's own Terraform state. A second state managing
# the same Helm release would fight over ownership and get reverted on
# the next deploy:observability-stack apply, so that piece stays a
# small imperative CLI step directly in the CI job instead.

data "azurerm_kubernetes_cluster" "main" {
  name                = var.aks_cluster_name
  resource_group_name = var.resource_group_name
}

locals {
  repo_root = "${path.module}/../../.."

  # ---------------------------------------------------------------------
  # Per-tenant Grafana datasources
  # ---------------------------------------------------------------------
  # Each file under datasources/ is already a complete
  # ConfigMap manifest (name/labels/data, see that directory's own
  # files) - decoded and passed straight through to a typed
  # kubernetes_config_map instead of kubernetes_manifest (plain
  # core-API object, no CRD involved - see terraform/README.md's own
  # note on why typed resources are preferred where available).
  datasource_files = fileset("${local.repo_root}/datasources", "*.yaml")
  datasources = {
    for f in local.datasource_files : trimsuffix(f, ".yaml") =>
    yamldecode(file("${local.repo_root}/datasources/${f}"))
  }

  # ---------------------------------------------------------------------
  # Per-tenant OTLP mTLS cert chain (NFR-04 mTLS rollout, Phase 2 -
  # README "Open Points") - three parallel directories, same
  # fileset()+yamldecode convention as local.datasources above,
  # generated by scripts/provision.py's update_tenant_client_certs()
  # (see that function's own docstring for why a per-tenant
  # INTERMEDIATE CA - not a single shared one - is required here: found
  # live that a shared CA let any tenant's cert authenticate as any
  # other). Unlike datasources (Grafana's own add/update-only
  # provisioning needs a tombstone file on offboarding), an offboarded
  # tenant's files are simply deleted by provision.py, so removing them
  # from manifests/ correctly destroys the Certificates/Issuer/Secrets
  # here too via for_each - no tombstone needed.
  # ---------------------------------------------------------------------
  tenant_intermediate_ca_files = fileset("${local.repo_root}/tls-certs/intermediate-cas", "*.yaml")
  tenant_intermediate_cas = {
    for f in local.tenant_intermediate_ca_files : trimsuffix(f, ".yaml") =>
    yamldecode(file("${local.repo_root}/tls-certs/intermediate-cas/${f}"))
  }

  tenant_issuer_files = fileset("${local.repo_root}/tls-certs/issuers", "*.yaml")
  tenant_issuers = {
    for f in local.tenant_issuer_files : trimsuffix(f, ".yaml") =>
    yamldecode(file("${local.repo_root}/tls-certs/issuers/${f}"))
  }

  tenant_client_cert_files = fileset("${local.repo_root}/tls-certs/clients", "*.yaml")
  tenant_client_certs = {
    for f in local.tenant_client_cert_files : trimsuffix(f, ".yaml") =>
    yamldecode(file("${local.repo_root}/tls-certs/clients/${f}"))
  }

  # gRPC port each tenant_id's own otlp/tenant-<id> receiver listens on
  # (collector-gateway/otel-gateway-collector.yaml, generated by
  # scripts/provision.py's tenant_grpc_port(): environment base + system_id,
  # F13) - tenant_id is "<system_id>-<env>", same convention used
  # throughout this repo (e.g. local.dashboards above).
  tenant_grpc_port_base = { prod = 20000, at = 30000, eng = 40000 }
  tenant_otlp_grpc_ports = {
    for tenant_id in keys(local.tenant_client_certs) :
    tenant_id => local.tenant_grpc_port_base[split("-", tenant_id)[1]] + tonumber(split("-", tenant_id)[0])
  }

  # ---------------------------------------------------------------------
  # Per-tenant Grafana dashboards - same convention as
  # observability-stack/main.tf's kubernetes_config_map_v1.dashboards
  # (genuinely tenant-agnostic: shared/ only) - 4087's own included
  # (IaC Roadmap milestone, done: 4087 is no longer excluded here/
  # special-cased in observability-stack, goes through onboarding and
  # this same deploy:tenants rollout like every other tenant).
  #
  # One flat file per system now (not one per environment) - environment
  # is an in-dashboard template variable instead (see
  # scripts/generate-system-dashboard.py's own header comment for why:
  # Grafana's dashboard file-provisioner only reliably supports one
  # folder level, confirmed live, grafana/grafana#107158). Grafana
  # folder is just "<system_id>" - same folder its own alert rule uses
  # (alerting/README.md). system_id is the leading token before the
  # first "-" in the filename - reliable, every filename here is
  # generated by scripts/generate-system-dashboard.py as
  # "<system_id>-<slug>.json". fileset() is non-recursive, so this
  # naturally excludes dashboards/shared/*.json and
  # dashboards/templates/** without an explicit filter.
  # ---------------------------------------------------------------------
  tenant_dashboard_files = fileset("${local.repo_root}/dashboards", "*.json")

  dashboards = {
    for f in local.tenant_dashboard_files : trimsuffix(f, ".json") => {
      folder   = split("-", trimsuffix(f, ".json"))[0]
      filename = f
      path     = "${local.repo_root}/dashboards/${f}"
    }
  }

  # ---------------------------------------------------------------------
  # Grafana Alerting - Unified Alerting RULES ONLY, no contact points/
  # notification policies/delivery channel configured anywhere in this
  # repo (see alerting/README.md) - a firing/pending/normal alert is only
  # ever visible on Grafana's own Alerting page. Fixed set (one file per
  # Demo Use Case's platform/application, plus one cross-tenant shared
  # rule) - hand-authored, not manifest-generated like the rest of this
  # file, but deployed here anyway: moved from observability-stack's own
  # state (deploy:observability-stack) after finding live that alert
  # rules pinned to onboarded systems going stale is a real, repeated
  # problem when their deployment is decoupled from the same systems'
  # dashboards/datasources - a routine onboarding pipeline (tenants:apply
  # -> tenants:rollout) has no reason to also remember a separate,
  # rarely-run full-platform-redeploy job. Rolling out here instead means
  # an alert-rules.yaml edit reaches the cluster the same way, same
  # cadence, as everything else in this file.
  # ---------------------------------------------------------------------
  platform_alert_dirs    = fileset("${local.repo_root}/alerting/platforms", "*/alert-rules.yaml")
  application_alert_dirs = fileset("${local.repo_root}/alerting/applications", "*/alert-rules.yaml")
  # openclaw-webhook.yaml is excluded here and provisioned by its own
  # kubernetes_config_map_v1.openclaw_webhook_contact_point resource below
  # (historical: it used to need templatefile() for the hook token, which
  # it now reads via $__file{} instead; kept separate so its ConfigMap
  # isn't destroyed and recreated by a resource-address change).
  shared_alert_files = setsubtract(
    fileset("${local.repo_root}/alerting/shared", "*.yaml"),
    ["openclaw-webhook.yaml"]
  )

  alert_rules = merge(
    { for f in local.platform_alert_dirs : "platform-${dirname(f)}" => {
      filename = "${dirname(f)}-alert-rules.yaml"
      path     = "${local.repo_root}/alerting/platforms/${f}"
    } },
    { for f in local.application_alert_dirs : "application-${dirname(f)}" => {
      filename = "${dirname(f)}-alert-rules.yaml"
      path     = "${local.repo_root}/alerting/applications/${f}"
    } },
    { for f in local.shared_alert_files : "shared-${trimsuffix(f, ".yaml")}" => {
      filename = f
      path     = "${local.repo_root}/alerting/shared/${f}"
    } },
  )
}

resource "kubernetes_config_map_v1" "tenant_datasources" {
  for_each = local.datasources

  metadata {
    name      = each.value.metadata.name
    namespace = each.value.metadata.namespace
    labels    = each.value.metadata.labels
  }

  data = each.value.data
}

# Certificate is a cert-manager CRD, not a core Kubernetes type - same
# kubernetes_manifest idiom as ../observability-stack-crs's own
# cluster_issuer_azuredns/grafana_cert, not a typed kubernetes_* resource.
# Applied first in this 3-resource chain - each tenant's own
# intermediate CA, signed by the shared internal-ca root.
resource "kubernetes_manifest" "tenant_intermediate_cas" {
  for_each = local.tenant_intermediate_cas

  manifest = each.value
}

# Namespaced Issuer (not ClusterIssuer) per tenant, referencing that
# tenant's own intermediate CA Secret from above - depends_on the whole
# resource (not per-key) since cert-manager needs the intermediate
# Secret to actually exist before an Issuer pointing at it is useful,
# and for_each gives Terraform no other way to express "this instance
# depends on that instance" across two different for_each resources.
resource "kubernetes_manifest" "tenant_issuers" {
  for_each = local.tenant_issuers

  manifest   = each.value
  depends_on = [kubernetes_manifest.tenant_intermediate_cas]
}

# The actual OTLP client leaf certificate, issued via that tenant's own
# Issuer above (spec.issuerRef.kind: Issuer) - never directly from the
# shared internal-ca ClusterIssuer, see update_tenant_client_certs()'s
# own docstring in scripts/provision.py for why that distinction is
# the entire point of this 3-resource chain.
resource "kubernetes_manifest" "tenant_client_certs" {
  for_each = local.tenant_client_certs

  manifest   = each.value
  depends_on = [kubernetes_manifest.tenant_issuers]
}

# NFR-04 mTLS rollout, Phase 3 (README "Open Points") - internal-only
# (ClusterIP, not LoadBalancer) Service exposing the Gateway's dynamic
# per-tenant mTLS receiver ports, purely so Traefik's IngressRouteTCP
# resources below have a stable Kubernetes Service to route to. This
# is the one piece that genuinely needs to vary with onboarding, and it
# safely can here - unlike terraform/environments/observability-stack's
# own otel_gateway_internal (a LoadBalancer, whose internal-IP
# annotation must be set at creation time), a plain ClusterIP Service
# has no such constraint, so it's free to live in this onboarding-scoped
# state right alongside the tenant-scoped ports it's actually exposing.
resource "kubernetes_service_v1" "otel_gateway_tenant_mtls" {
  metadata {
    name      = "otel-gateway-tenant-mtls"
    namespace = "observability"
  }
  spec {
    type = "ClusterIP"
    selector = {
      "app.kubernetes.io/name" = "otel-gateway-collector"
    }
    dynamic "port" {
      for_each = local.tenant_otlp_grpc_ports
      content {
        # Kubernetes port names are capped at 15 chars (IANA_SVC_NAME) -
        # too short for "tenant-<tenant_id>-grpc". Not referenced by
        # name anywhere (the IngressRouteTCP resources below target by
        # number), so just needs to be short and unique per port.
        name        = "p${port.value}"
        port        = port.value
        target_port = port.value
      }
    }
  }
}

# One IngressRouteTCP per tenant on Traefik's dedicated otlpmtls
# entrypoint (helm/values/traefik-values.yaml). tls.passthrough: true -
# deliberately NOT terminating TLS on Traefik at all: HostSNI is
# matched straight from the TLS ClientHello's SNI extension, sent in
# cleartext before anything is decrypted, so Traefik never needs to
# see the certificate, hold a TLSOption, or reference the Gateway's
# server cert itself - it's a pure Layer-4 SNI router here. The actual
# TLS handshake (server cert presentation AND client cert
# verification) happens end-to-end between the client and the
# Gateway's own otlp/tenant-<id> receiver (collector-gateway/
# otel-gateway-collector.yaml, already built in Phase 3's own
# provision.py changes) - unchanged from how it would behave reached
# directly, Traefik just picks which port to forward the still-fully-
# encrypted bytes to.
#
# "<tenant_id>.otlp.internal" needs no real DNS entry - it's a
# synthetic routing key the client's own OTLP exporter sets as its TLS
# server_name_override (documented on migration, not yet done - see
# README B-section), never meant to resolve anywhere.
resource "kubernetes_manifest" "tenant_otlp_ingressroute" {
  for_each = local.tenant_client_certs

  manifest = {
    apiVersion = "traefik.io/v1alpha1"
    kind       = "IngressRouteTCP"
    metadata = {
      name      = "otlp-${each.key}"
      namespace = "observability"
    }
    spec = {
      entryPoints = ["otlpmtls"]
      routes = [
        {
          match    = "HostSNI(`${each.key}.otlp.internal`)"
          services = [{ name = kubernetes_service_v1.otel_gateway_tenant_mtls.metadata[0].name, port = local.tenant_otlp_grpc_ports[each.key] }]
        }
      ]
      tls = {
        passthrough = true
      }
    }
  }
  depends_on = [kubernetes_service_v1.otel_gateway_tenant_mtls]
}

# ---------------------------------------------------------------------------
# Pyroscope ingest credentials (F03) - one random password per onboarded
# tenant for the Pyroscope ingest proxy (terraform/environments/
# observability-stack, pyroscope_ingest_proxy), which sets X-Scope-OrgID
# from the authenticated user. Same tenant set as the OTLP client certs.
#   - pyroscope-ingest-htpasswd: the proxy's user file ({PLAIN}, see the
#     proxy's own comment for why).
#   - pyroscope-ingest-<tenant_id>: username/password for the senders -
#     read by the VM instrumentation CI jobs (kubectl) and by
#     fleet-4139-postgresql (data source) for its in-cluster Java app.
# Rotation: `terraform apply -replace='random_password.pyroscope_ingest["<tenant_id>"]'`
# here, then rerun that tenant's instrumentation job.
# ---------------------------------------------------------------------------
resource "random_password" "pyroscope_ingest" {
  for_each = local.tenant_client_certs
  length   = 32
  special  = false
}

resource "kubernetes_secret_v1" "pyroscope_ingest_htpasswd" {
  metadata {
    name      = "pyroscope-ingest-htpasswd"
    namespace = "observability"
  }
  data = {
    htpasswd = join("", [
      for tenant_id in sort(keys(random_password.pyroscope_ingest)) :
      "${tenant_id}:{PLAIN}${random_password.pyroscope_ingest[tenant_id].result}\n"
    ])
  }
}

resource "kubernetes_secret_v1" "pyroscope_ingest_credentials" {
  for_each = random_password.pyroscope_ingest
  metadata {
    name      = "pyroscope-ingest-${each.key}"
    namespace = "observability"
  }
  data = {
    username = each.key
    password = each.value.result
  }
}


# Per-tenant daily ingestion budgets, read by observability-stack's
# ingestion-midnight-snapshot CronJob (mounted by name, optional - see
# that CronJob's own comment). Lives in this state, not
# observability-stack's, so it rolls out in the same tenants:rollout as
# every other onboarding-generated file, from tenants:apply's artifact.
resource "kubernetes_config_map_v1" "tenant_ingestion_budgets" {
  metadata {
    name      = "tenant-ingestion-budgets"
    namespace = "observability"
  }
  data = {
    "ingestion-daily-budgets.yaml" = file("${local.repo_root}/helm/values/ingestion-daily-budgets.yaml")
  }
}

resource "kubernetes_config_map_v1" "tenant_dashboards" {
  for_each = local.dashboards

  metadata {
    name      = "grafana-dashboard-${each.key}"
    namespace = "observability"
    labels = {
      grafana_dashboard = "1"
    }
    annotations = {
      grafana_folder = each.value.folder
    }
  }

  data = {
    (each.value.filename) = file(each.value.path)
  }
}

resource "kubernetes_config_map_v1" "alert_rules" {
  for_each = local.alert_rules

  metadata {
    name      = "grafana-alert-${each.key}"
    namespace = "observability"
    labels = {
      grafana_alert = "1"
    }
  }

  data = {
    (each.value.filename) = file(each.value.path)
  }
}

# See shared_alert_files' own comment above for why this one file is
# handled separately from the generic loop it's excluded from.
resource "kubernetes_config_map_v1" "openclaw_webhook_contact_point" {
  metadata {
    name      = "grafana-alert-shared-openclaw-webhook"
    namespace = "observability"
    labels = {
      grafana_alert = "1"
    }
  }

  data = {
    # No token in here anymore - the file reads it via $__file{} from a
    # Secret mounted into Grafana (see the file's own header comment).
    "openclaw-webhook.yaml" = file("${local.repo_root}/alerting/shared/openclaw-webhook.yaml")
  }

  # $__file{} on a file Grafana doesn't have aborts Grafana's whole
  # alerting provisioning pass, not just this contact point. The mount
  # comes from deploy:observability-stack (a separate state/job), so
  # refuse to apply this before it's there.
  lifecycle {
    precondition {
      condition = anytrue([
        for v in try(data.kubernetes_resources.grafana_deployment.objects[0].spec.template.spec.volumes, []) :
        v.name == "openclaw-hooks"
      ])
      error_message = "Grafana has no openclaw-hooks secret mount yet - run deploy:observability-stack first (it creates the grafana-openclaw-hooks Secret and mounts it), then re-run this job."
    }
  }
}

data "kubernetes_resources" "grafana_deployment" {
  api_version    = "apps/v1"
  kind           = "Deployment"
  namespace      = "observability"
  field_selector = "metadata.name==grafana"
}

# ---------------------------------------------------------------------------
# No Grafana restart on datasource/dashboard changes. An earlier version
# ran `kubectl rollout restart deployment/grafana` here on every change
# so offboarding tombstones (deleteDatasources, see provision.py's
# _render_tombstone_configmap()) got processed - but Grafana runs a
# single replica with strategy Recreate (RWO PVC), so every onboarding
# took Grafana down for up to a minute. Not needed: the chart's
# datasource/dashboard/alert sidecars run in WATCH mode and call
# Grafana's own /api/admin/provisioning/*/reload endpoints on every
# change. Verified live: a test datasource provisioned via ConfigMap
# appeared, and was removed again ~6 s after its ConfigMap became a
# deleteDatasources tombstone - same Pod, no restart.
# ---------------------------------------------------------------------------

resource "local_sensitive_file" "kubeconfig" {
  content  = data.azurerm_kubernetes_cluster.main.kube_config_raw
  filename = "${path.module}/.terraform-kubeconfig"
}

# ---------------------------------------------------------------------------
# Gateway OpenTelemetryCollector CR - moved here from
# observability-stack-crs (see this file's own header comment for why).
# Still a null_resource + kubectl apply, not a typed/kubernetes_manifest
# resource - found live (back when this lived in observability-stack-crs)
# that the hashicorp/kubernetes provider's kubernetes_manifest
# implementation hits "Error: Provider produced inconsistent result
# after apply... .object: wrong final value type: incorrect object
# attributes" on this specific CR, 100% reproducibly, while the
# otherwise-identical otel-agent-daemonset.yaml (same CRD, simpler
# spec.config) applies cleanly - a known upstream provider limitation
# with complex/loosely-typed CRD schemas, not a config mistake (see
# README's Known Pitfalls for the full writeup). Kubeconfig content in
# triggers + on_failure=continue on destroy, see below.
# ---------------------------------------------------------------------------

resource "null_resource" "otel_gateway_collector" {
  triggers = {
    manifest_hash      = filesha256("${local.repo_root}/collector-gateway/otel-gateway-collector.yaml")
    kubeconfig_content = data.azurerm_kubernetes_cluster.main.kube_config_raw
  }

  provisioner "local-exec" {
    environment = {
      KUBECONFIG = local_sensitive_file.kubeconfig.filename
    }
    command = "kubectl apply -f '${local.repo_root}/collector-gateway/otel-gateway-collector.yaml'"
  }

  # Deliberately no destroy-time provisioner here - see
  # otel_gateway_collector_teardown below.
  depends_on = [local_sensitive_file.kubeconfig]
}

# Deletes the gateway CR on a real `terraform destroy` only. This used
# to be a destroy-time provisioner on otel_gateway_collector above -
# but that resource is REPLACED whenever the manifest hash changes, and
# a replacement runs destroy provisioners too. Found live: every
# onboarding deleted the OpenTelemetryCollector CR and re-created it
# (fresh generation 1), so the operator tore down the whole gateway
# Deployment instead of rolling it - no gateway pod at all until the new
# ones were ready (15 min when they were blocked on missing Secrets).
# terraform_data, not null_resource: a changed `input` is updated in
# place, never a replacement (only triggers_replace would replace it),
# so the kubeconfig used at destroy time stays current (AKS credential
# rotation, cluster re-creation) while nothing but a real teardown ever
# destroys this resource. With it destroyed first (depends_on), the CR
# goes before the apply resource.
resource "terraform_data" "otel_gateway_collector_teardown" {
  input = data.azurerm_kubernetes_cluster.main.kube_config_raw

  provisioner "local-exec" {
    when = destroy
    # Best-effort only, never blocks the destroy chain - the AKS cluster
    # this object lives in typically gets destroyed right after anyway.
    on_failure = continue
    environment = {
      KUBECONFIG_CONTENT = self.input
    }
    command = <<-EOT
      TMP_KUBECONFIG=$(mktemp)
      echo "$KUBECONFIG_CONTENT" > "$TMP_KUBECONFIG"
      KUBECONFIG="$TMP_KUBECONFIG" kubectl delete opentelemetrycollector otel-gateway -n observability --ignore-not-found
      rm -f "$TMP_KUBECONFIG"
    EOT
  }

  depends_on = [null_resource.otel_gateway_collector]
}

# ---------------------------------------------------------------------------
# Node agent OpenTelemetryCollector CR (4087) - moved here from
# observability-stack-crs: its container-log routing is generated from
# the manifests' k8s_namespaces (scripts/provision.py
# update_agent_log_routing(), F20), so it has to roll out together with
# the gateway's namespace routing on every onboarding/offboarding, not
# only on the next manual deploy:observability-stack. Same apply/teardown
# pattern as the gateway above.
# ---------------------------------------------------------------------------

resource "null_resource" "otel_agent_collector" {
  triggers = {
    manifest_hash      = filesha256("${local.repo_root}/instrumentation/platforms/4087-container-platform/config.yaml")
    kubeconfig_content = data.azurerm_kubernetes_cluster.main.kube_config_raw
  }

  provisioner "local-exec" {
    environment = {
      KUBECONFIG = local_sensitive_file.kubeconfig.filename
    }
    command = "kubectl apply -f '${local.repo_root}/instrumentation/platforms/4087-container-platform/config.yaml'"
  }

  depends_on = [local_sensitive_file.kubeconfig]
}

resource "terraform_data" "otel_agent_collector_teardown" {
  input = data.azurerm_kubernetes_cluster.main.kube_config_raw

  provisioner "local-exec" {
    when       = destroy
    on_failure = continue
    environment = {
      KUBECONFIG_CONTENT = self.input
    }
    command = <<-EOT
      TMP_KUBECONFIG=$(mktemp)
      echo "$KUBECONFIG_CONTENT" > "$TMP_KUBECONFIG"
      KUBECONFIG="$TMP_KUBECONFIG" kubectl delete opentelemetrycollector otel-agent -n observability --ignore-not-found
      rm -f "$TMP_KUBECONFIG"
    EOT
  }

  depends_on = [null_resource.otel_agent_collector]
}

# moved blocks for the kubernetes provider v3 rename -
# unversioned resource types deprecated in favour of _v1 (see
# the provider's own v3.0.0 CHANGELOG) - required so Terraform
# treats this as a rename of the same live object, not a
# destroy+recreate.
moved {
  from = kubernetes_config_map.tenant_datasources
  to   = kubernetes_config_map_v1.tenant_datasources
}

moved {
  from = kubernetes_config_map.tenant_dashboards
  to   = kubernetes_config_map_v1.tenant_dashboards
}

moved {
  from = kubernetes_config_map.alert_rules
  to   = kubernetes_config_map_v1.alert_rules
